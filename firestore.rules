rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // USERNAME LOOKUP COLLECTION
    // Example: usernames/akash -> { uid: "abc123" }
    // Public read allowed so portfolio page can find UID from username
    // ─────────────────────────────────────────────
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // USER DOCUMENTS
    // ─────────────────────────────────────────────
    match /users/{userId} {

      // Public can read only published public portfolios
      allow read: if resource.data.published == true
                  && resource.data.visibility != 'private';

      // Owner can always read/write own profile
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // ── Skills ──
      match /skills/{skillId} {
        allow read: if get(/databases/$(database)/documents/users/$(userId)).data.published == true
                    && get(/databases/$(database)/documents/users/$(userId)).data.visibility != 'private';
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // ── Projects ──
      match /projects/{projectId} {
        allow read: if get(/databases/$(database)/documents/users/$(userId)).data.published == true
                    && get(/databases/$(database)/documents/users/$(userId)).data.visibility != 'private';
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // ── Education ──
      match /education/{eduId} {
        allow read: if get(/databases/$(database)/documents/users/$(userId)).data.published == true
                    && get(/databases/$(database)/documents/users/$(userId)).data.visibility != 'private';
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // ── Settings (private) ──
      match /settings/{settingId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}