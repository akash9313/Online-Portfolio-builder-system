rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public username lookup
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profile document
    match /users/{userId} {
      // Public can read only published and non-private profiles
      allow read: if resource.data.published == true
                  && resource.data.visibility != 'private';

      // Owner can read/write own profile
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Skills
      match /skills/{skillId} {
        allow read: if get(/databases/$(database)/documents/users/$(userId)).data.published == true
                    && get(/databases/$(database)/documents/users/$(userId)).data.visibility != 'private';
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Projects
      match /projects/{projectId} {
        allow read: if get(/databases/$(database)/documents/users/$(userId)).data.published == true
                    && get(/databases/$(database)/documents/users/$(userId)).data.visibility != 'private';
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Education
      match /education/{eduId} {
        allow read: if get(/databases/$(database)/documents/users/$(userId)).data.published == true
                    && get(/databases/$(database)/documents/users/$(userId)).data.visibility != 'private';
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Settings
      match /settings/{settingId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Messages
      match /messages/{messageId} {
        allow create: if true;
        allow read, update, delete: if request.auth != null
                                   && request.auth.uid == userId;
      }
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}