rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public username lookup - secured against hijacking
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // User profile document
    match /users/{userId} {
      // Public can read only published and non-private profiles
      allow read: if resource.data.published == true
                  && resource.data.visibility != 'private';

      // Owner can read/write own profile
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Skills
      match /skills/{skillId} {
        allow read: if get(/databases/$(database)/documents/users/$(userId)).data.published == true
                    && get(/databases/$(database)/documents/users/$(userId)).data.visibility != 'private';
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Projects
      match /projects/{projectId} {
        allow read: if get(/databases/$(database)/documents/users/$(userId)).data.published == true
                    && get(/databases/$(database)/documents/users/$(userId)).data.visibility != 'private';
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Education
      match /education/{eduId} {
        allow read: if get(/databases/$(database)/documents/users/$(userId)).data.published == true
                    && get(/databases/$(database)/documents/users/$(userId)).data.visibility != 'private';
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Experience
      match /experience/{expId} {
        allow read: if get(/databases/$(database)/documents/users/$(userId)).data.published == true
                    && get(/databases/$(database)/documents/users/$(userId)).data.visibility != 'private';
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Settings
      match /settings/{settingId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Messages - require valid payload structure & size limits
      match /messages/{messageId} {
        allow create: if request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 100
                      && request.resource.data.email is string
                      && request.resource.data.email.size() > 0
                      && request.resource.data.email.size() <= 200
                      && request.resource.data.message is string
                      && request.resource.data.message.size() > 0
                      && request.resource.data.message.size() <= 2000;
        allow read, update, delete: if request.auth != null
                                   && request.auth.uid == userId;
      }
    }

    // Reviews collection - schema validated and size limited
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.author is string
                    && request.resource.data.author.size() > 0
                    && request.resource.data.author.size() <= 100
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 1000
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if request.auth != null && request.auth.token.email == 'akashuchachariya9313@gmail.com';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}